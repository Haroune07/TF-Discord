<UserControl x:Class="Frontend.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Converters="clr-namespace:Frontend.Converters"
             xmlns:components="clr-namespace:Frontend.Views.Components"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800"
             Background="#313338">

    <UserControl.Resources>
        <Converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Message list -->
        <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="0" Margin="0,10,0,0">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                            <Grid Margin="16,4,16,4" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="Modifier"
                                                              Command="{Binding PlacementTarget.Tag.EditMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Supprimer"
                                                              Command="{Binding PlacementTarget.Tag.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOwnMessage}" Value="False">
                                                <Setter Property="ContextMenu" Value="{x:Null}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <components:AvatarControl Grid.Column="0"
                                                          User="{Binding Message.Sender}"
                                                          Width="40" Height="40"
                                                          VerticalAlignment="Top"
                                                          Margin="0,0,12,0"/>

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="{Binding Message.Sender.Username}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="15"/>
                                        <TextBlock Text="{Binding FormattedDate}"
                                                   Foreground="#949BA4"
                                                   FontSize="12"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Message.Content}"
                                               Foreground="#DBDEE1"
                                               FontSize="15"
                                               TextWrapping="Wrap"/>
                                    
                                    <TextBlock Text="(modifié)"
                                               Foreground="#6D6F78"
                                               FontSize="11"
                                               Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Message.IsEdited}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    
                                </StackPanel>
                            </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Typing indicator -->
        <TextBlock Grid.Row="1"
                   Text="{Binding TypingText}"
                   Foreground="#949BA4"
                   FontSize="12"
                   Margin="16,0,16,4"
                   Visibility="{Binding TypingText, Converter={StaticResource StringToVisibilityConverter}}"/>

        <!-- Edit mode banner -->
        <Border Grid.Row="2"
                Background="#2B2D31"
                Padding="16,6"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Modification d'un message — "
                               Foreground="#949BA4"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Échap pour annuler"
                               Foreground="#5865F2"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Command="{Binding CancelEditCommand}"
                        Content="✕"
                        Background="Transparent"
                        Foreground="#949BA4"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Input bar -->
        <Border Grid.Row="3" Background="#383A40" CornerRadius="8" Margin="16,0,16,24" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         Foreground="#DBDEE1"
                         BorderThickness="0"
                         FontSize="15"
                         VerticalAlignment="Center"
                         Margin="5,0,16,0"
                         KeyDown="TextBox_KeyDown"/>

                <Button Grid.Column="1"
                        Command="{Binding SendMessageCommand}"
                        Background="#5865F2"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="15,8"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Envoyer"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Content" Value="Modifier"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
