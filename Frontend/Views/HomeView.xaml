<UserControl 
    x:Class="Frontend.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Frontend.Views"
    xmlns:views="clr-namespace:Frontend.Views"
    xmlns:ViewModels="clr-namespace:Frontend.ViewModels"
    xmlns:components="clr-namespace:Frontend.Views.Components"
    xmlns:converters="clr-namespace:Frontend.Converters"
    mc:Ignorable="d"
    d:DesignHeight="720"
    d:DesignWidth="1280">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#1E1F22" x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="235"/>
        </Grid.ColumnDefinitions>

        <!-- Colonne 0 - sidebar serveurs -->
        <StackPanel Grid.Column="0" Background="#1E1F22" Margin="0,12,0,0">
            <Border Width="48" Height="48" CornerRadius="14" Background="#5865F2" Margin="0,0,0,8">
                <Button Command="{Binding GoToHomeCommand}" Background="Transparent" BorderThickness="0">
                    <Image Source="/Static/Images/home_button_image.png"
                           Stretch="Uniform" Width="25" Height="25"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Border>
            <Separator Background="#35363C" HorizontalAlignment="Center" Width="32" Margin="0,4,0,12"/>
            <views:ServerListView DataContext="{Binding ServerList}"/>
        </StackPanel>

        <!-- Colonne 1 - sidebar channels ou DMs -->
        <Grid Grid.Column="1" Background="#2B2D31">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#1E1F22" BorderThickness="0,0,0,1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Messages Prives" Foreground="White" FontWeight="SemiBold"
                               Margin="16,0"
                               Visibility="{Binding DataContext.IsDMMode, 
                                            ElementName=RootGrid,
                                            Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="Channels" Foreground="White" FontWeight="SemiBold"
                               Margin="16,0"
                               Visibility="{Binding DataContext.IsServerMode, 
                                            ElementName=RootGrid,
                                            Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Mode serveur : channels -->
            <views:ChannelListView Grid.Row="1" DataContext="{Binding ChannelList}"
                                   Visibility="{Binding DataContext.IsServerMode, 
                                                ElementName=RootGrid,
                                                Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Mode DM : liste d'users -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding DataContext.IsDMMode,
                                       ElementName=RootGrid,
                                       Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <!-- Pending Requests Section -->
                    <TextBlock Text="PENDING REQUESTS" Foreground="#949BA4" FontSize="11" FontWeight="Bold" Margin="16,16,16,8"
                               Visibility="{Binding UserList.PendingRequests.Count, Converter={StaticResource IntToVisibilityConverter}}"/>
                    <ItemsControl ItemsSource="{Binding UserList.PendingRequests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Friend.Username}" Foreground="White" VerticalAlignment="Center" Margin="8,0"/>
                                    <Button Grid.Column="1" Content="✓" Background="#248046" Foreground="White" Width="24" Height="24" Margin="2,0"
                                            Command="{Binding DataContext.UserList.AcceptRequestCommand, ElementName=RootGrid}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="2" Content="✕" Background="#DA373C" Foreground="White" Width="24" Height="24" Margin="2,0"
                                            Command="{Binding DataContext.UserList.DeclineRequestCommand, ElementName=RootGrid}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="DIRECT MESSAGES" Foreground="#949BA4" FontSize="11" FontWeight="Bold" Margin="16,16,16,8"
                               Visibility="{Binding IsDMMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ListBox ItemsSource="{Binding UserList.Users}"
                             Background="Transparent" BorderThickness="0"
                             Visibility="{Binding DataContext.IsDMMode,
                                          ElementName=RootGrid,
                                          Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Username}"
                                        Background="Transparent"
                                        Foreground="White"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Left"
                                        Padding="8,6"
                                        Command="{Binding DataContext.UserList.OpenDMCommand, 
                                                  ElementName=RootGrid}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Profile View (merged from PR #22) -->
            <views:ProfileView DataContext="{Binding Profile}" Margin="0,0,0,4" Grid.Row="2"></views:ProfileView>
        </Grid>

        <!-- Colonne 2 - chat -->
        <Grid Grid.Column="2" Background="#313338">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#1E1F22" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="Friends" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Separator Width="1" Height="24" Background="#3F4147" Margin="16,0"/>
                        <TextBlock Text="Online" Foreground="#B5BAC1" Margin="16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="All" Foreground="#B5BAC1" Margin="16,0" VerticalAlignment="Center"/>
                        
                        <views:SearchUserView x:Name="UserSearchBox" DataContext="{Binding SearchVM}"/>
                    </StackPanel>

                    <!-- Popup for search results -->
                    <Popup IsOpen="{Binding SearchVM.HasResults, Mode=OneWay}"
                           PlacementTarget="{Binding ElementName=UserSearchBox}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           HorizontalOffset="-45"
                           PopupAnimation="Fade">
                        <Border Background="#2B2D31" 
                                Width="300" 
                                CornerRadius="8"
                                BorderBrush="#1E1F22" BorderThickness="1"
                                Padding="4"
                                Margin="0,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <ListBox ItemsSource="{Binding SearchVM.Users}" 
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <views:UserInviteView />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <views:ChatView Grid.Row="1" DataContext="{Binding ActiveChat}" Loaded="ChatView_Loaded" />
        </Grid>

        <!-- Colonne 3 - active now -->
        <Border Grid.Column="3"
                Background="#313338"
                BorderBrush="#3F4147"
                BorderThickness="1,0,0,0"
                Padding="16">
            <StackPanel>
                <TextBlock Text="Active Now"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,16"/>
                <TextBlock Text="It's quiet for now..."
                           Foreground="#B5BAC1"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
