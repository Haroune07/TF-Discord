<UserControl 
    x:Class="Frontend.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Frontend.Views"
    xmlns:views="clr-namespace:Frontend.Views"
    xmlns:ViewModels="clr-namespace:Frontend.ViewModels"
    xmlns:components="clr-namespace:Frontend.Views.Components"
    mc:Ignorable="d"
    d:DesignHeight="720"
    d:DesignWidth="1280">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#1E1F22" x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="235"/>
        </Grid.ColumnDefinitions>

        <!-- Colonne 0 - sidebar serveurs -->
        <StackPanel Grid.Column="0" Background="#1E1F22" Margin="0,12,0,0">
            <Border Width="48" Height="48" CornerRadius="14" Background="#5865F2" Margin="0,0,0,8">
                <Button Command="{Binding GoToHomeCommand}" Background="Transparent" BorderThickness="0">
                    <Image Source="/Static/Images/home_button_image.png"
                           Stretch="Uniform" Width="25" Height="25"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Border>
            <Separator Background="#35363C" HorizontalAlignment="Center" Width="32" Margin="0,4,0,12"/>
            <views:ServerListView DataContext="{Binding ServerList}"/>
        </StackPanel>

        <!-- Colonne 1 - sidebar channels ou DMs -->
        <Grid Grid.Column="1" Background="#2B2D31">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#1E1F22" BorderThickness="0,0,0,1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Messages privés" Foreground="White" FontWeight="SemiBold"
                               Margin="16,0"
                               Visibility="{Binding DataContext.IsDMMode, 
                                            ElementName=RootGrid,
                                            Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="Channels" Foreground="White" FontWeight="SemiBold"
                               Margin="16,0"
                               Visibility="{Binding DataContext.IsServerMode, 
                                            ElementName=RootGrid,
                                            Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Mode serveur : channels -->
            <views:ChannelListView Grid.Row="1" DataContext="{Binding ChannelList}"
                                   Visibility="{Binding DataContext.IsServerMode, 
                                                ElementName=RootGrid,
                                                Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Mode DM : liste d'users -->
            <ListBox Grid.Row="1" ItemsSource="{Binding UserList.Users}"
                     Background="Transparent" BorderThickness="0"
                     Visibility="{Binding DataContext.IsDMMode,
                                  ElementName=RootGrid,
                                  Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Username}"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                HorizontalContentAlignment="Left"
                                Padding="8,6"
                                Command="{Binding DataContext.UserList.OpenDMCommand, 
                                          ElementName=RootGrid}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" Background="#232428" Padding="8,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <components:AvatarControl DataContext="{Binding CurrentUserAvatar}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                          Width="32" Height="32" 
                          Margin="0,0,8,0">
                            <components:AvatarControl.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Téléverser une image de profil (url)" 
                      Command="{Binding Path=PlacementTarget.Tag.UploadAvatarCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                    <MenuItem Header="Statut en ligne">
                                        <MenuItem Header="En ligne" 
                          Command="{Binding Path=PlacementTarget.Tag.SetOnlineStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="True"/>
                                        <MenuItem Header="Invisible" 
                          Command="{Binding Path=PlacementTarget.Tag.SetOnlineStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                          CommandParameter="False"/>
                                    </MenuItem>
                                </ContextMenu>
                            </components:AvatarControl.ContextMenu>
                        </components:AvatarControl>

                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding User.Username}" Foreground="White"
                                       FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentUserAvatar.OnlineStatusText}" Foreground="#B5BAC1" FontSize="10"/>
                            <TextBlock Text="{Binding MemberSince}" Foreground="#B5BAC1" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Command="{Binding GoToLoginCommand}" Width="33"
                            Margin="181,0,10,0" Background="#313338">
                        <Image Source="/Static/Images/logoutlogo.png" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Colonne 2 - chat -->
        <Grid Grid.Column="2" Background="#313338">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#1E1F22" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="Friends" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Separator Width="1" Height="24" Background="#3F4147" Margin="16,0"/>
                    <TextBlock Text="Online" Foreground="#B5BAC1" Margin="16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="All" Foreground="#B5BAC1" Margin="16,0" VerticalAlignment="Center"/>
                    <Border Background="#248046" CornerRadius="4" Padding="8,2" Margin="16,0">
                        <TextBlock Text="Add Friend" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>

            <views:ChatView Grid.Row="1" DataContext="{Binding ActiveChat}" />
        </Grid>

        <!-- Colonne 3 - active now -->
        <Border Grid.Column="3"
                Background="#313338"
                BorderBrush="#3F4147"
                BorderThickness="1,0,0,0"
                Padding="16">
            <StackPanel>
                <TextBlock Text="Active Now"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,16"/>
                <TextBlock Text="It's quiet for now..."
                           Foreground="#B5BAC1"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>