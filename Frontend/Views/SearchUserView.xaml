<UserControl x:Class="Frontend.Views.SearchUserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Frontend.Views"
             mc:Ignorable="d" 
             d:DesignWidth="210">
    <Border Background="#1E1F22" CornerRadius="4" Padding="4,2" Margin="5,0,16,0" Width="210">
        <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                 Background="Transparent"
                 Foreground="#DBDEE1"
                 BorderThickness="0"
                 FontSize="14"
                 VerticalAlignment="Center"/>
    </Border>
</UserControl>
