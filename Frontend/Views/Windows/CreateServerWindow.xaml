<Window x:Class="Frontend.Views.CreateServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Converters="clr-namespace:Frontend.Converters"
        Title="Créer un serveur"
        Width="400" Height="269"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2B2D31">

    <Window.Resources>
        <Converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Nom du serveur"
                   Foreground="White" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"
                 Background="#383A40" Foreground="White"
                 BorderThickness="0" Padding="8,6"
                 FontSize="14"/>

        <TextBlock Text="Image du serveur (URL, optionnel)"
           Foreground="White" FontWeight="SemiBold"
           Margin="0,12,0,8"/>

        <TextBox Text="{Binding ServerImageUrl, UpdateSourceTrigger=PropertyChanged}"
         Background="#383A40" Foreground="White"
         BorderThickness="0" Padding="8,6"
         FontSize="14"/>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#FF6B6B" FontSize="12"
                   Margin="0,6,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <Button Content="Créer"
                Command="{Binding CreateCommand}"
                Background="#5865F2" Foreground="White"
                BorderThickness="0" Padding="0,10"
                Margin="0,16,0,0"
                Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Button.Resources>
        </Button>
    </StackPanel>
</Window>