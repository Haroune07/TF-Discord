<UserControl x:Class="Frontend.Views.UserInviteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Frontend.Views"
             mc:Ignorable="d"
             xmlns:components="clr-namespace:Frontend.Views.Components">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Border Background="#2B2D31" CornerRadius="4" Padding="8" Margin="0,2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Avatar -->
            <components:AvatarControl Grid.Column="0"
                                     AvatarImage="{Binding ProfileImageUrl}" 
                                     Initials="{Binding Username}" 
                                     Width="32" Height="32"/>

            <!-- Username -->
            <TextBlock Grid.Column="1" Text="{Binding Username}" 
                       Foreground="White" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="12,0"/>

            <!-- Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Command="{Binding DMCommand}" Background="Transparent" BorderThickness="0" Margin="4,0">
                    <Image Source="/Static/Images/DM.png" Width="20" Height="20" Opacity="0.7"/>
                </Button>
                <Button Command="{Binding InviteServerCommand}"
                        Background="Transparent" BorderThickness="0" Margin="4,0"
                        ToolTip="Inviter sur le serveur actif"
                        Visibility="{Binding CanInviteToServer, Converter={StaticResource BoolToVis}}">
                    <Image Source="/Static/Images/plus.png" Width="20" Height="20" Opacity="0.7"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
