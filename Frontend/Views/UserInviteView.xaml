<UserControl x:Class="Frontend.Views.UserInviteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Frontend.Views"
             mc:Ignorable="d"
             xmlns:components="clr-namespace:Frontend.Views.Components" Height="73" Width="292">
    <Grid Background="#383A40">
        <!-- L'avatar (pense à ajouter une DependencyProperty ImageUrl dans ton contrôle Avatar) -->
        <components:AvatarControl 
        AvatarImage="{Binding ProfileImageUrl}" 
        Initials="{Binding Username}" 
        Margin="0,0,229,0"/>

        <!-- Le nom d'utilisateur -->
        <TextBlock Text="{Binding Username}" Foreground="White" Margin="89,0,213,0"/>

        <!-- Bouton lié à SelectCommand du ViewModel -->
        <Button Command="{Binding DMCommand}" Margin="146,0,79,0" Background="#383A40">
            <Image Source="/Static/Images/DM.png"/>
        </Button>
        <Button Margin="218,0,10,0" Background="#383A40" RenderTransformOrigin="0.5,0.5" Command="{Binding InviteServerCommand}">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
            <Image Source="/Static/Images/plus.png"></Image>
        </Button>
    </Grid>
</UserControl>
