<Window x:Class="Frontend.Views.InviteToServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inviter au serveur"
        Height="180" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#313338">
    <StackPanel Margin="20">
        <TextBlock Text="Nom d'utilisateur à inviter"
                   Foreground="#DBDEE1" FontSize="14" Margin="0,0,0,8"/>
        <TextBox x:Name="UsernameBox"
                 Background="#1E1F22" Foreground="White"
                 BorderBrush="#3F4147" Padding="8" FontSize="14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Width="90" Margin="0,0,8,0"
                    Click="Cancel_Click" Background="#4E5058" Foreground="White" BorderThickness="0"/>
            <Button Content="Inviter" Width="90"
                    Click="Invite_Click" Background="#5865F2" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </StackPanel>
</Window>
